# ============================================================
#  KiloWallpaper - git attributes
# ============================================================

# 文本文件统一以 LF 入库；检出时再按下面更具体的规则还原。
* text=auto eol=lf

# Windows 批处理必须 CRLF：cmd.exe 对带标签(goto/label)的 LF 版 .bat 会解析异常。
# 项目约定：.bat 用纯 ASCII 或 GBK 编写（中文 cmd.exe 默认 cp936，
# UTF-8 无 BOM 会乱码，见 CONTRIBUTING.md）；一律 CRLF 换行。
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：禁止任何换行 / 编码转换
*.mp4  binary
*.mov  binary
*.avi  binary
*.wmv  binary
*.mkv  binary
*.webm binary
*.m4v  binary
*.gif  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.bmp  binary
*.exe  binary
*.dll  binary
*.obj  binary
*.pdb  binary
*.lib  binary

# 语言统计与 diff
*.cpp  text
*.h    text
*.md   text
*.py   text
